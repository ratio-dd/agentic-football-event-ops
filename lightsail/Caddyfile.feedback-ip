:80 {
  handle /.well-known/acme-challenge/* {
    root * /srv/acme
    file_server
  }
  handle {
    redir https://{host}{uri} permanent
  }
}

# The public AFC hostname CNAMEs to the Lightsail Static IP's AWS hostname.
# Caddy obtains and renews its trusted public certificate automatically.
afc.awscommunity.cn {
  encode zstd gzip
  reverse_proxy app:8787
}
