{
  "name": "football-workbench",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "npm run lightsail:start",
    "build": "npm run lightsail:build",
    "start": "node lightsail/server.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/independent-allocation-acceptance.test.mjs && npm run test:lightsail && npm run test:e2e",
    "test:e2e": "playwright test",
    "acceptance:serve": "node scripts/acceptance-demo.mjs",
    "acceptance:release": "node scripts/release-acceptance.mjs",
    "ops:export-offline": "node scripts/export-offline-ops.mjs",
    "test:lightsail": "npm run lightsail:build && node --test tests/lightsail-adapter.test.mjs tests/offline-export.test.mjs tests/tenant-http-isolation.test.mjs",
    "lightsail:build": "node lightsail/build-worker.mjs",
    "lightsail:start": "npm run lightsail:build && node lightsail/server.mjs",
    "lint": "eslint scripts lightsail tests --ext .js,.mjs"
  },
  "dependencies": { "qrcode": "^1.5.4" },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "eslint": "9.39.4",
    "esbuild": "^0.27.0"
  },
  "type": "module"
}
